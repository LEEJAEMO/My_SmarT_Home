# 전체 덮어쓰기 금지. 기존 설정에 병합하고 ha core check 후 적용하세요.
# 모든 명령은 verified: false로 출고됩니다. 실제 entity/action 대조 및 물리 검증 후에만 true.
homeassistant:
  packages: !include_dir_named packages
conversation:
lovelace:
  dashboards:
    smart-home:
      mode: yaml
      title: 스마트홈
      icon: mdi:home-assistant
      show_in_sidebar: true
      filename: dashboards/smart_home.yaml
switchbot_ir_allowlist:
  # native HA 패널 경로는 OpenAPI 토큰 없이도 사용 가능합니다.
  token: !secret switchbot_api_token
  secret: !secret switchbot_api_secret
  min_gap_seconds: 2
  commands:
    # 아래 switch 서비스는 예시입니다. 실제 패널이 climate 등이라면 그대로 켜지 마세요.
    # 사용자 확인 의미: ON=전원 토글 / ON=모드 다음 / OFF=예약 다음.
    daikin_power_once:
      backend: ha
      entity_id: !secret ha_aircon_power_entity
      service: switch.turn_on
      verified: false
    daikin_mode_next:
      backend: ha
      entity_id: !secret ha_aircon_mode_timer_entity
      service: switch.turn_on
      verified: false
    daikin_timer_next:
      backend: ha
      entity_id: !secret ha_aircon_mode_timer_entity
      service: switch.turn_off
      verified: false
    fan_power:
      device_id: !secret switchbot_fan_device_id
      command: "POWER"
      command_type: customize
      verified: false
    fan_speed_cycle:
      device_id: !secret switchbot_fan_device_id
      command: "Fan Speed 3"
      command_type: customize
      verified: false
    fan_timer_cycle:
      device_id: !secret switchbot_fan_device_id
      command: "Timer"
      command_type: customize
      verified: false
    fan_mute_toggle:
      device_id: !secret switchbot_fan_device_id
      command: "Mute"
      command_type: customize
      verified: false
    light_on:
      device_id: !secret switchbot_light_device_id
      command: "ON"
      command_type: customize
      verified: false
    light_off:
      device_id: !secret switchbot_light_device_id
      command: "OFF"
      command_type: customize
      verified: false
    light_brighter:
      device_id: !secret switchbot_light_device_id
      command: "밝기증가"
      command_type: customize
      verified: false
    light_dimmer:
      device_id: !secret switchbot_light_device_id
      command: "밝기감소"
      command_type: customize
      verified: false
    projector_on:
      device_id: !secret switchbot_projector_device_id
      command: "ON"
      command_type: customize
      verified: false
    projector_off:
      device_id: !secret switchbot_projector_device_id
      command: "OFF"
      command_type: customize
      verified: false
    projector_power:
      device_id: !secret switchbot_projector_device_id
      command: "전원"
      command_type: customize
      verified: false
