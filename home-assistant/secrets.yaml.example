# SwitchBot 앱 > 프로필 > 환경설정 > 개발자 옵션에서 발급합니다.
# 실제 secrets.yaml은 외부 공유나 OneDrive 공개 링크에 올리지 마세요.
switchbot_api_token: "PASTE_TOKEN_HERE"
switchbot_api_secret: "PASTE_SECRET_HERE"

# SwitchBot OpenAPI GET /v1.1/devices 결과에서 IR 가상 리모컨 deviceId를 넣습니다.
# 에어컨 프리셋을 각각 별도 가상 리모컨으로 만들었으면 각 ID가 다릅니다.
switchbot_daikin_cool_device_id: "DAIKIN_COOL_26_DEVICE_ID"
switchbot_daikin_heat_device_id: "DAIKIN_HEAT_20_DEVICE_ID"
switchbot_daikin_dry_device_id: "DAIKIN_DRY_DEVICE_ID"
switchbot_daikin_off_device_id: "DAIKIN_OFF_DEVICE_ID"
switchbot_fan_device_id: "COMFEE_FAN_DEVICE_ID"
switchbot_light_device_id: "LIGHT_DEVICE_ID"
switchbot_projector_device_id: "PROJECTOR_DEVICE_ID"

